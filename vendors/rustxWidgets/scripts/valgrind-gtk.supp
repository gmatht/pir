# Suppress common GTK3/fontconfig/pango/GLX process-exit leak noise that shows
# up in the stress and example binaries on Ubuntu's system libraries.
#
# Keep this file focused on external-library shutdown noise. Do not add broad
# suppressions for Rust-side allocations unless they have been investigated and
# confirmed to be harmless third-party behavior.

{
   gtk3_pango_entry_fontconfig_value_save_indirect
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   fun:strdup
   fun:FcValueSave
   ...
   fun:pango_layout_get_unknown_glyphs_count
   ...
   fun:g_type_create_instance
   fun:g_object_new_with_properties
   fun:g_object_new
   fun:_ZN18gtk_dynamic_loader8wrappers5Entry3new*
}

{
   gtk3_pango_entry_fontconfig_render_prepare_indirect
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:calloc
   ...
   fun:FcFontRenderPrepare
   fun:FcFontSetMatch
   ...
   fun:start_thread
   fun:clone
}

{
   gtk3_pango_entry_fontconfig_substitute_indirect
   Memcheck:Leak
   match-leak-kinds: indirect
   fun:malloc
   ...
   fun:FcConfigSubstituteWithPat
   ...
   fun:pango_layout_get_unknown_glyphs_count
   ...
   fun:g_type_create_instance
   fun:g_object_new_with_properties
   fun:g_object_new
   fun:_ZN18gtk_dynamic_loader8wrappers5Entry3new*
}

