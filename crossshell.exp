#!/usr/bin/expect -f
set timeout 60
# Session created by one shell
spawn bash -c "exec /root/src/pir/target/debug/pir"
expect "❯"
send "apple from shell A\r"
expect "❯"
send "banana from shell A\r"
expect "❯"
send "\x04"
expect eof

# Resume attempted from a DIFFERENT shell (different parent pid)
spawn bash -c "exec /root/src/pir/target/debug/pir -r"
expect "❯"
send "\033\[A"
sleep 1
send "Q"
sleep 1
send "\x7f"
sleep 1
send "\x04"
expect eof
