#!/usr/bin/env bash
# ai-perm-request — AI-side helper.
# Drops a structured, auditable permission request into the request spool.
# The request is NOT applied by the AI; a privileged enforcer (run by root)
# validates and applies it. See perm-enforcer and README.md.
set -euo pipefail

REQUEST_DIR="${AI_PERM_REQUEST_DIR:-/tmp/ai-perm-requests}"
DEFAULT_TTL="1h"

usage() {
  cat >&2 <<'EOF'
ai-perm-request — request a read grant from the privileged enforcer.

USAGE:
  ai-perm-request grant-read <path> [--reason "..."] [--ttl 2h|30m|1d]
  ai-perm-request revoke <grant-id>
  ai-perm-request list

The request is queued in $AI_PERM_REQUEST_DIR (default /tmp/ai-perm-requests).
You must ask an operator to run:  sudo perm-enforcer
EOF
  exit 2
}

[ "$#" -ge 1 ] || usage
op="$1"; shift

gen_id() {
  # Host-independent, collision-resistant id without external deps.
  printf '%s-%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$$" "$(head -c8 /dev/urandom | od -An -tx1 | tr -d ' \n')"
}

case "$op" in
  grant-read)
    [ "$#" -ge 1 ] || usage
    path="$1"; shift
    reason="(no reason given)"
    ttl="$DEFAULT_TTL"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --reason) reason="${2:-}"; shift 2 ;;
        --ttl)    ttl="${2:-}";     shift 2 ;;
        *) echo "ai-perm-request: unknown arg: $1" >&2; exit 2 ;;
      esac
    done
    # Resolve to absolute, canonical path (symlinks expanded) for the request.
    if [ -e "$path" ] || [ -L "$path" ]; then
      path="$(realpath "$path")"
    else
      path="$(realpath -m "$path")"
    fi
    id="$(gen_id)"
    mkdir -p "$REQUEST_DIR"
    chmod 700 "$REQUEST_DIR"
    cat > "$REQUEST_DIR/$id.json" <<JSON
{
  "id": "$id",
  "op": "grant-read",
  "path": "$path",
  "reason": "$reason",
  "ttl": "$ttl",
  "requested_by": "$(id -un)",
  "requested_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
JSON
    echo "Queued grant-read request: $id"
    echo "  path:   $path"
    echo "  ttl:    $ttl"
    echo "  reason: $reason"
    echo "Ask an operator to run: sudo perm-enforcer"
    ;;
  revoke)
    [ "$#" -ge 1 ] || usage
    id="$1"; shift
    mkdir -p "$REQUEST_DIR"
    cat > "$REQUEST_DIR/$id.revoke.json" <<JSON
{
  "id": "revoke-$id",
  "op": "revoke",
  "grant_id": "$id",
  "requested_by": "$(id -un)",
  "requested_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
JSON
    echo "Queued revoke request for grant: $id"
    echo "Ask an operator to run: sudo perm-enforcer"
    ;;
  list)
    echo "Pending requests in $REQUEST_DIR:"
    ls -1 "$REQUEST_DIR"/*.json 2>/dev/null || echo "  (none)"
    ;;
  *)
    usage ;;
esac
