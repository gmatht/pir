#!/usr/bin/expect -f
set timeout 60
# Single bash whose pid both `pir` invocations share (mimics one terminal).
spawn bash -c "exec /root/src/pir/target/debug/pir"
expect "❯"
send "prompt alpha from shell one\r"
expect "❯"
send "prompt bravo from shell one\r"
expect "❯"
send "\x04"
expect eof

spawn bash -c "exec /root/src/pir/target/debug/pir -r"
expect "❯"
send "\033\[A"
sleep 1
send "Z"
sleep 1
send "\x7f"
sleep 1
send "\x04"
expect eof
